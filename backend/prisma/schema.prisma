// Prisma Schema — KPSyDesk Suite - Door Waar (Multi-Tenant & Multi-Secteur UEMOA)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SectorType {
  QUINCAILLERIE
  MULTISERVICES_IT
  TAILLEUR
}

enum BillingStatus {
  TRIAL_7D
  ACTIVE
  SUSPENDED
  EXPIRED
  ARCHIVED
}

model Tenant {
  id                 String        @id @default(uuid())
  code               String        @unique // ex: QNC-0001, ITS-0001, TLR-0001
  name               String
  sectorType         SectorType
  country            String        @default("SN") // SN, CI, ML
  phone              String? // Téléphone entreprise / gérant
  email              String? // Email principal entreprise
  billingStatus      BillingStatus @default(TRIAL_7D)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  isDemo             Boolean       @default(false)
  isPermanentDemo    Boolean       @default(false) // 🔒 Démo système permanent (Immunisé contre la purge)
  deletedAt          DateTime? // Soft delete timestamp
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  users                User[]
  roles                Role[]
  stockItems           StockItem[]
  repairTickets        RepairTicket[]
  itServicePackages    ITServicePackage[]
  clientMeasurements   ClientMeasurement[]
  paymentProofs        PaymentProof[]
  quotes               Quote[]
  invoices             Invoice[]
  stockMovements       StockMovement[]
  tailleurOrders       TailleurOrder[]
  saasQuotes           SaaSQuote[]
  billingSequences     BillingSequence[]
  purchaseOrders       PurchaseOrder[]
  tailleurCatalogItems TailleurCatalogItem[]
  inventorySessions    InventorySession[]
  clients              Client[]
  suppliers            Supplier[]
  depots               Depot[]
  paymentInstallments  PaymentInstallment[]

  @@map("tenants")
}

model PaymentProof {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider            String // WAVE, ORANGE_MONEY, BANK_TRANSFER
  transactionRef      String
  amount              Float
  expectedAmount      Float? // Montant officiel calculé lors de la soumission
  appliedMonthlyPrice Float?    @default(6500) // Tarif de base appliqué
  durationMonths      Int       @default(1) // 1, 6, 12 mois
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedAt         DateTime  @default(now())
  processedAt         DateTime?

  @@index([tenantId])
  @@unique([transactionRef])
  @@map("payment_proofs")
}

model PricingConfig {
  id               String   @id @default(uuid())
  baseMonthlyPrice Float    @default(6500) // Tarif unique 6 500 XOF / mois
  discount6Months  Float    @default(0.10) // 10% de réduction sur 6 mois
  discount12Months Float    @default(0.20) // 20% de réduction sur 12 mois
  currency         String   @default("XOF")
  isDefault        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("pricing_configs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String?  // null = notification Super Admin globale
  type      String   // PAYMENT_PENDING, PAYMENT_APPROVED, PAYMENT_REJECTED, SUBSCRIPTION_EXPIRING, NEW_TENANT, SUBSCRIPTION_EXPIRED
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  // Route frontend optionnelle (ex: /billing)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// -------------------------------------------------------------
// MODULES DE CONSOLE SUPER ADMIN (KPSyDesk Suite - Door Waar)
// -------------------------------------------------------------

// Global SaaS : Moteur d'Intégration de Paiement
model PaymentProviderConfig {
  id                     String   @id @default(uuid())
  provider               String   @unique // WAVE, ORANGE_MONEY, BIZAO, STRIPE, PAYTECH
  displayName            String
  enabled                Boolean  @default(false)
  environment            String   @default("TEST") // TEST, PRODUCTION
  currency               String   @default("XOF")
  publicKey              String?
  encryptedSecret        String? // Chiffré au niveau serveur (AES-256-GCM)
  encryptedWebhookSecret String? // Chiffré au niveau serveur (AES-256-GCM)
  qrCodeUrl              String?  @db.Text
  callbackUrl            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("payment_provider_configs")
}

// Global SaaS : Configuration Serveur SMS OTP
model SmsProviderConfig {
  id              String   @id @default(uuid())
  provider        String   @unique // ORANGE_SMS, TWILIO, INFOBIP, INTOUCH
  displayName     String
  enabled         Boolean  @default(false)
  environment     String   @default("TEST")
  senderId        String   @default("KPSyDesk")
  apiUrl          String?
  encryptedSecret String? // Chiffré au niveau serveur (AUCUNE clé en clair)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("sms_provider_configs")
}

// Tenant-Scoped & Global : Devis Commercial SaaS Super Admin
model SaaSQuote {
  id             String   @id @default(uuid())
  quoteNumber    String   @unique // ex: SQ-2026-0001
  tenantId       String? // Optionnel : NULL = Devis global/prospect, ID = Devis tenant
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  clientName     String
  clientEmail    String
  clientPhone    String?
  planName       String   @default("Tarif Pro UEMOA")
  durationMonths Int      @default(12)
  subtotal       Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  tax            Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  currency       String   @default("XOF")
  status         String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED
  validUntil     DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("saas_quotes")
}

// Global SaaS / Audit Immuable : Journal d'Audit Centralisé
model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String // ID de l'utilisateur (Pas de FK dure pour préserver l'historique d'audit même si l'utilisateur est supprimé)
  actorRole    String
  action       String // ex: TENANT_SUSPENDED, PAYMENT_APPROVED, ROLE_CHANGED, CONFIG_UPDATED
  resourceType String // TENANT, PAYMENT_PROOF, PROVIDER_CONFIG, USER
  resourceId   String
  tenantId     String? // Nullable pour les actions globales Super Admin
  result       String   @default("SUCCESS") // SUCCESS, FAILURE, FORBIDDEN
  metadata     Json? // Changements apportés (diff anonymisé sans secrets)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Global SaaS / Anonymisé : Analytics & Audiences Plateforme
model PlatformAnalytics {
  id              String   @id @default(uuid())
  eventType       String // PAGE_VIEW, SESSION_START, LOGIN_ATTEMPT, FEATURE_USED
  sessionId       String // Anonymisé
  route           String
  deviceType      String? // DESKTOP, MOBILE, TABLET
  browser         String?
  operatingSystem String?
  countryCode     String? // ⚠️ Pas de valeur par défaut 'SN' : NULL si indéterminé
  tenantId        String? // Nullable
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
  @@index([sessionId])
  @@index([tenantId])
  @@map("platform_analytics")
}

// Global SaaS / Sécurité : Configuration plateforme globale
model PlatformSettings {
  id          String   @id @default("singleton")
  enforce2FA  Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// Global SaaS / Securite : Invitations d'Équipe Super Admin (Collaborateurs)
model SuperAdminInvitation {
  id          String   @id @default(uuid())
  email       String
  roleName    String // SUPER_ADMIN, FINANCE, SUPPORT, AUDITOR
  tokenHash   String   @unique // Stockage exclusif du Hash SHA-256 (Jamais de token brut en BDD)
  invitedById String
  status      String   @default("INVITED") // INVITED, ACCEPTED, CANCELLED, EXPIRED
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("super_admin_invitations")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String   @unique // format: {CODE_TENANT}-{SEQUENCE}
  fullName     String
  email        String
  emailVerified Boolean @default(false)
  phone        String
  passwordHash String
  mustChangePassword Boolean @default(false)
  isActive     Boolean  @default(true)
  
  // TOTP (Super Admin)
  totpSecret            String?
  totpEnabled           Boolean  @default(false)
  totpBackupCodesHashed String[]
  totpFailedAttempts    Int      @default(0)
  totpSessionId         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles UserRole[]
  tailleurOrders TailleurOrder[] @relation("OrderAssignee")

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String? // null pour les rôles système comme SUPER_ADMIN
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // SUPER_ADMIN, ADMIN_TENANT, EMPLOYEE
  description String?
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String      @id @default(uuid())
  code        String      @unique // ex: stock:read, tickets:create, measurements:write
  sectorType  SectorType? // null si permission générique/transverse
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -------------------------------------------------------------
// MODULE CRM (CLIENTS & FOURNISSEURS)
// -------------------------------------------------------------
model Client {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  email     String?
  address   String?
  ninea     String?
  rccm      String?
  notes     String?
  type      String   @default("INDIVIDUAL") // INDIVIDUAL, COMPANY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes        Quote[]
  invoices      Invoice[]
  repairTickets RepairTicket[]
  measurements  ClientMeasurement[]
  tailleurOrders TailleurOrder[]

  @@index([tenantId])
  @@map("clients")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  ninea     String?
  rccm      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

// -------------------------------------------------------------
// MODULE QUINCAILLERIE
// -------------------------------------------------------------
model StockItem {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  sku            String
  unit           String // sac, kg, piece, metre
  purchasePrice  Float
  sellingPrice   Float
  quantity       Int      @default(0)
  alertThreshold Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quoteLines     QuoteLine[]
  invoiceLines   InvoiceLine[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
  inventoryLines InventorySessionLine[]
  repairParts    RepairTicketPart[]
  balances       StockBalance[]

  @@index([tenantId])
  @@map("stock_items")
}

model Depot {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  isMain      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  balances             StockBalance[]
  movementsSource      StockMovement[] @relation("SourceDepot")
  movementsDestination StockMovement[] @relation("DestinationDepot")

  @@index([tenantId])
  @@map("depots")
}

model StockBalance {
  id          String    @id @default(uuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  depotId     String
  depot       Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([stockItemId, depotId])
  @@index([depotId])
  @@map("stock_balances")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockItemId        String
  stockItem          StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type               MovementType
  quantity           Int
  unitPrice          Float?
  reason             String?
  sourceDepotId      String?
  sourceDepot        Depot?       @relation("SourceDepot", fields: [sourceDepotId], references: [id], onDelete: SetNull)
  destinationDepotId String?
  destinationDepot   Depot?       @relation("DestinationDepot", fields: [destinationDepotId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())

  @@index([tenantId])
  @@index([stockItemId])
  @@map("stock_movements")
}

enum InventorySessionStatus {
  DRAFT
  COMPLETED
}

model InventorySession {
  id          String                 @id @default(uuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label       String
  periodType  String
  periodStart DateTime?
  periodEnd   DateTime?
  status      InventorySessionStatus @default(DRAFT)
  adjusted    Boolean                @default(false)
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  lines       InventorySessionLine[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([tenantId])
  @@map("inventory_sessions")
}

model InventorySessionLine {
  id                 String           @id @default(uuid())
  inventorySessionId String
  session            InventorySession @relation(fields: [inventorySessionId], references: [id], onDelete: Cascade)
  stockItemId        String
  stockItem          StockItem        @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  unitCost           Float // Prix d'achat capturé au moment de la création
  systemQuantity     Int
  countedQuantity    Int? // Reste null tant que non compté
  discrepancy        Int              @default(0)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([inventorySessionId])
  @@index([stockItemId])
  @@map("inventory_session_lines")
}

// -------------------------------------------------------------
// MODULE MULTISERVICES IT
// -------------------------------------------------------------
model RepairTicket {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNumber  String
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String
  clientPhone   String
  deviceModel   String
  issueDesc     String
  status        String // RECEIVED, DIAGNOSIS, IN_REPAIR, READY, DELIVERED, CANCELLED
  estimatedCost Float?
  finalCost     Float?
  notes         String?
  photoBefore   String?
  photoAfter    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usedParts RepairTicketPart[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId])
  @@map("repair_tickets")
}

model RepairTicketPart {
  id             String       @id @default(uuid())
  repairTicketId String
  repairTicket   RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  stockItemId    String
  stockItem      StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantity       Int          @default(1)
  createdAt      DateTime     @default(now())

  @@index([repairTicketId])
  @@index([stockItemId])
  @@map("repair_ticket_parts")
}

model ITServicePackage {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  estimatedHours String // ex: "2h00" (texte libre, cohérent avec le frontend)
  priceXOF       Float
  category       String // MAINTENANCE, SYSTEM, HARDWARE, NETWORK
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@map("it_service_packages")
}

// -------------------------------------------------------------
// MODULE DEVIS ET FACTURATION GENERIQUE (BILLING)
// -------------------------------------------------------------
enum BillingDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BillingDocumentType {
  QUOTE
  INVOICE
}

model Quote {
  id          String                @id @default(uuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String
  clientId    String?
  client      Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName  String
  clientPhone String?
  clientEmail String?
  status      BillingDocumentStatus @default(DRAFT)
  totalAmount Float                 @default(0)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  lines   QuoteLine[]
  invoice Invoice?

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("quotes")
}

model QuoteLine {
  id          String     @id @default(uuid())
  quoteId     String
  quote       Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  description String
  quantity    Float      @default(1)
  unitPrice   Float      @default(0)
  vatRate     Float      @default(18)
  totalPrice  Float      @default(0)

  @@map("quote_lines")
}

model Invoice {
  id            String                @id @default(uuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        String
  sourceQuoteId String?               @unique
  sourceQuote   Quote?                @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String
  clientPhone   String?
  clientEmail   String?
  status        BillingDocumentStatus @default(DRAFT)
  totalAmount   Float                 @default(0)
  paidAmount    Float                 @default(0)
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  lines         InvoiceLine[]
  tailleurOrder TailleurOrder?
  payments      PaymentInstallment[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("invoices")
}

model InvoiceLine {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  description String
  quantity    Float      @default(1)
  unitPrice   Float      @default(0)
  vatRate     Float      @default(18)
  totalPrice  Float      @default(0)

  @@map("invoice_lines")
}

model PaymentInstallment {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float
  paymentDate DateTime @default(now())
  method      String   @default("CASH") // CASH, CARD, WAVE, ORANGE_MONEY, CHEQUE, TRANSFER
  reference   String?  // Reference of transaction
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payment_installments")
}

model BillingSequence {
  id           String              @id @default(uuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year         Int
  type         BillingDocumentType
  currentValue Int                 @default(0)

  @@unique([tenantId, year, type])
  @@map("billing_sequences")
}

// -------------------------------------------------------------
// MODULE TAILLEUR (COUTURE)
// -------------------------------------------------------------
model ClientMeasurement {
  id              String  @id @default(uuid())
  tenantId        String
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName      String
  clientPhone     String
  beneficiaryName String? // ex: "Fils (Moussa)", "Fille (Awa)", "Épouse", etc.
  garmentType     String // Boubou, Costume, Robe, Taille Basse
  measurements    Json // Champs flexibles: { tourPoitrine: 95, longueurManche: 62, ... }
  notes           String?

  parentMeasurementId String?
  parentMeasurement   ClientMeasurement?  @relation("FamilyMembers", fields: [parentMeasurementId], references: [id], onDelete: Cascade)
  members             ClientMeasurement[] @relation("FamilyMembers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders TailleurOrder[]

  @@index([tenantId])
  @@index([parentMeasurementId])
  @@map("client_measurements")
}

enum TailleurOrderStatus {
  ORDERED
  CUTTING
  SEWING
  FITTING
  READY
  DELIVERED
  CANCELLED
}

model TailleurOrder {
  id             String              @id @default(uuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber    String
  clientId       String?
  client         Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName     String
  clientPhone    String
  garmentType    String
  fabricDesc     String?
  status         TailleurOrderStatus @default(ORDERED)
  fittingDate    DateTime?
  deliveryDate   DateTime?
  totalPrice     Float               @default(0)
  advancePaid    Float               @default(0)
  invoiceId      String?             @unique
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  measurementsId String?
  measurement    ClientMeasurement?  @relation(fields: [measurementsId], references: [id], onDelete: SetNull)
  
  fabricProvided Boolean             @default(false)
  fabricMeters   Float?
  assigneeId     String?
  assignee       User?               @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  items          TailleurOrderItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@map("tailleur_orders")
}

model TailleurCatalogItem {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  category             String   @default("Traditionnel")
  estimatedPrice       Float    @default(0)
  delaysDays           Int      @default(5)
  description          String?
  fabricRecommendation String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
  @@map("tailleur_catalog_items")
}

model TailleurOrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       TailleurOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  garmentType String
  unitPrice   Float         @default(0)
  quantity    Int           @default(1)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@map("tailleur_order_items")
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName    String
  itemDescription String
  stockItemId     String?
  stockItem       StockItem?          @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  qtyOrdered      Int
  totalCostXOF    Float
  status          PurchaseOrderStatus @default(PENDING)
  notes           String?
  orderDate       DateTime            @default(now())
  receivedDate    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("purchase_orders")
}
